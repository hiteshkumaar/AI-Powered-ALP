generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         UserRole @default(USER)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans              Plan[]
  studySessions      StudySession[]
  progressSnapshots  ProgressSnapshot[]
  recommendations  Recommendation[]
}

model Plan {
  id        String     @id @default(cuid())
  userId    String
  title     String
  goal      String?
  status    PlanStatus @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              PlanItem[]
  studySessions      StudySession[]
  progressSnapshots  ProgressSnapshot[]
  recommendations  Recommendation[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model PlanItem {
  id          String     @id @default(cuid())
  planId      String
  title       String
  description String?
  dueDate     DateTime?
  order       Int        @default(0)
  status      ItemStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
  @@index([planId, status])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  planId    String?
  topic     String?
  notes     String?
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([planId])
}

model ProgressSnapshot {
  id             String   @id @default(cuid())
  userId         String
  planId         String
  snapshotDate   DateTime
  minutesStudied Int      @default(0)
  confidence     Int?
  reflection     String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, snapshotDate])
  @@index([userId, snapshotDate])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  planId    String?
  title     String
  content   String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([planId])
}
